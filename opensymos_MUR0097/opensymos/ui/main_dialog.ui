     <widget class="QWidget" name="tab_help">
      <attribute name="title">
       <string>Help</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_11">
       <item>
        <widget class="QLabel" name="label_18">
         <property name="text">
          <string>&lt;h1&gt;OpenSymos Help&lt;/h1&gt;</string>
         </property>
         <property name="textFormat">
          <enum>Qt::RichText</enum>
         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="label_19">
         <property name="text">
          <string>&lt;h2&gt;Quick Start Guide&lt;/h2&gt;
&lt;ol&gt;
&lt;li&gt;&lt;b&gt;Load your data&lt;/b&gt; into QGIS project
  &lt;ul&gt;
    &lt;li&gt;Terrain: Raster layer (DEM/DTM)&lt;/li&gt;
    &lt;li&gt;Sources: Point/Polygon layer with emissions&lt;/li&gt;
    &lt;li&gt;Receptors: Point layer for calculation points&lt;/li&gt;
    &lt;li&gt;Wind: XML/TXT file with wind rose data&lt;/li&gt;
  &lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Configure each tab&lt;/b&gt; from left to right&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Validate data&lt;/b&gt; using the &quot;Validate All&quot; button&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Go to Calculation tab&lt;/b&gt; to run the model there&lt;/li&gt;
&lt;li&gt;&lt;b&gt;View results&lt;/b&gt; in the Results tab (opens after calculation)&lt;/li&gt;
&lt;/ol&gt;</string>
         </property>
         <property name="textFormat">
          <enum>Qt::RichText</enum>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="label_20">
         <property name="text">
          <string>&lt;h2&gt;More Resources&lt;/h2&gt;
&lt;p&gt;• &lt;b&gt;Full documentation:&lt;/b&gt; &lt;a href=&quot;https://github.com/ruz76/qgis_opensymos_3&quot;&gt;GitHub repository&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;• &lt;b&gt;Settings:&lt;/b&gt; Plugins → OpenSymos → Settings&lt;/p&gt;
&lt;p&gt;• &lt;b&gt;About plugin:&lt;/b&gt; Plugins → OpenSymos → About&lt;/p&gt;</string>
         </property>
         <property name="textFormat">
          <enum>Qt::RichText</enum>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="openExternalLinks">
          <bool>true</bool>
         </property>
        </widget>
